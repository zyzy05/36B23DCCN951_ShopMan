<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="vn.shopman.model.User" %>

<%
    User currentUser = (User) session.getAttribute("currentUser");
    String requiredRole = (String) request.getAttribute("requiredRole");

    if (currentUser == null) {
        response.sendRedirect(request.getContextPath() + "/index.jsp?msg=login");
        return;
    }

    if (requiredRole != null && !requiredRole.equals(currentUser.getRole())) {
        response.sendError(403, "Bạn không có quyền truy cập chức năng này.");
        return;
    }

    // Customer-only screens require a linked customer record for their DAO queries.
    if ("CUSTOMER".equals(requiredRole) && currentUser.getCustomerId() == null) {
        response.sendError(403, "Tài khoản khách hàng chưa được liên kết với hồ sơ khách hàng.");
        return;
    }
%>
